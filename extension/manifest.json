{
  "manifest_version": 3,
  "name": "Genealogy Capsule",
  "version": "0.2.3",
  "key": "",
  "description": "Save the genealogy record you are viewing as cited, hashed evidence on your own computer.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "debugger",
    "downloads"
  ],
  "host_permissions": [
    "http://127.0.0.1:8765/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Capture this page with Genealogy Capsule",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "media-detect.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
